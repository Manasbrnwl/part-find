generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  date_of_birth DateTime?
  phone_number  String?   @unique
  fcm_token     String?
  jwt_token     String?
  otp           String?
  otp_exp       DateTime?
  // Pending self-service change (email / phone / role) awaiting OTP confirmation.
  // Kept separate from the login otp fields so a pending change can't clash with login.
  change_otp     String?
  change_otp_exp DateTime?
  pending_change Json?
  weight        Float?
  gender        String?
  address       String?
  state         String?
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  last_active_at   DateTime? // last time the user made an authenticated request (for inactivity reminders)
  last_reminded_at DateTime? // last time we sent an inactivity re-engagement reminder
  height        Float?
  is_active     Boolean   @default(true)
  english_level String?
  role          Role?     @default(USER)
  skills        String[]  @default([])
  intro_video_link String?

  // KYC — Aadhaar. Nullable because existing accounts predate this; "mandatory"
  // is enforced in the app layer (profile-completion). Number is stored plain
  // but is always masked in API responses and never logged; the image is stored
  // in a private dir and only served via an authenticated, ownership-checked route.
  aadhaar_number String? @unique
  aadhaar_image  String? // filename in the private uploads/aadhaar dir

  // Referral code this account signed up with (set once, at first-time signup).
  referred_by_code String?

  // Recruiter-specific fields
  recruiter_company_name         String?
  recruiter_type                 String? // Individual, Company, Agency, Event Organizer
  recruiter_company_registration String? // GST/PAN (optional)
  recruiter_company_address      String?
  recruiter_company_logo         String? // URL to logo image

  // Relations
  posts               Post[]
  userImages          images[]
  comments            postApplied[]
  savePosts           savePosts[]
  UserCategory        UserCategory[]
  recruiterIndustries RecruiterIndustry[] @relation("UserToIndustries")
  recruiterGigTypes   RecruiterGigType[]  @relation("UserToGigTypes")
  ratingsReceived     Rating[]            @relation("UserRatings")
  ratingsGiven        Rating[]            @relation("RecruiterRatings")
  recruiterRatingsReceived RecruiterRating[] @relation("RecruiterReceivedRatings")
  recruiterRatingsGiven    RecruiterRating[] @relation("UserRecruiterRatings")
  refreshTokens       RefreshToken[]
  experience          String[]            @default([])
  education           Json                @default("[]")
  flaggedReports      FlaggedUser[]
  postReports         PostReport[]        @relation("UserPostReports")
  certificates        Certificate[]       @relation("UserCertificates")
  issuedCertificates  Certificate[]       @relation("RecruiterCertificates")
}

model RecruiterIndustry {
  id         Int      @id @default(autoincrement())
  user_id    String
  industry   String // Events, Hospitality, Retail, Logistics, etc.
  created_at DateTime @default(now()) @db.Timestamp(6)
  is_active  Boolean  @default(true)
  user       User     @relation("UserToIndustries", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, industry])
}

model RecruiterGigType {
  id         Int      @id @default(autoincrement())
  user_id    String
  gigType    String // Promoters, Ushers, Event Staff, Security, etc.
  created_at DateTime @default(now()) @db.Timestamp(6)
  is_active  Boolean  @default(true)
  user       User     @relation("UserToGigTypes", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, gigType])
}

model UserCategory {
  id          Int         @id @default(autoincrement())
  user_id     String
  category_id Int
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  updated_at  DateTime?   @db.Timestamp(6)
  is_active   Boolean     @default(true)
  JobCategory JobCategory @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_category")
  User        User        @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_post")

  @@unique([user_id, category_id], map: "user_category_unique")
}

model images {
  id         String   @id @default(uuid())
  userId     String
  image      String
  is_deleted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model Post {
  id             String         @id @default(uuid())
  userId         String
  title          String         @db.VarChar(255)
  content        String?
  requirement    String?
  total          Int            @default(1)
  boys           Int?           @default(0)
  girls          Int?           @default(0)
  endDate        DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  location       String?
  payment        Float?
  paymentGirls   Float?
  paymentBoys    Float?
  paymentDate    DateTime?
  dressCode      String?
  responsibility String?
  role           String?
  lunch          Boolean        @default(false)
  startDate      DateTime       @default(now())
  is_active      Boolean        @default(true)
  is_urgent      Boolean        @default(false)
  // Recruitment toggle: recruiter can close applications early (before endDate).
  // Closed posts are hidden from the discovery feeds and reject new applications.
  is_recruiting  Boolean        @default(true)
  company_name   String?
  latitude       Float?
  longitude      Float?
  category       String?

  // Employment type of the post (Part-Time, Full-Time, ...). Nullable so existing
  // posts stay valid; managed through the PostType table.
  type_id        Int?
  type           PostType?      @relation(fields: [type_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Time basis of the post — whether it is paid/measured hourly, daily or monthly.
  pay_period     PayPeriod?

  // Admin moderation: a new post is PENDING and NOT shown to users until an
  // admin approves it. Existing posts are backfilled to APPROVED in the migration.
  approval_status PostApprovalStatus @default(PENDING)
  approval_remark String?            // admin note / rejection reason
  approved_at     DateTime?

  user           User           @relation(fields: [userId], references: [id])
  PostCategory   PostCategory[]
  comments       postApplied[]
  savePosts      savePosts[]
  ratings        Rating[]
  recruiterRatings RecruiterRating[]
  certificates   Certificate[]
  reports        PostReport[]

  @@unique([userId, title, startDate], map: "post_unique")
}

model postApplied {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status?  @default(PENDING)
  remark    String?  // withdrawal reason (set by the applicant when they cancel)
  reject_reason String? // reason the recruiter/admin rejected this application
  attended     Boolean   @default(false) // recruiter marked this applicant as present at the event
  attended_at  DateTime?
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId], map: "user_post_unique")
}

// Employment type of a post (Part-Time, Full-Time, Internship, ...). Admin-managed.
model PostType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  posts       Post[]
}

model JobCategory {
  id           Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(100)
  description  String?
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @db.Timestamp(6)
  PostCategory PostCategory[]
  UserCategory UserCategory[]
}

model PostCategory {
  id          Int         @id @default(autoincrement())
  post_id     String
  category_id Int
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  updated_at  DateTime?   @db.Timestamp(6)
  is_active   Boolean     @default(true)
  JobCategory JobCategory @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_category")
  Post        Post        @relation(fields: [post_id], references: [id], onUpdate: NoAction, map: "fk_post")

  @@unique([post_id, category_id], map: "post_category_unique")
}

model savePosts {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId], map: "user_save_post_unique")
  @@index([userId], map: "user_save_post_index")
  @@index([postId], map: "post_save_post_index")
}

enum Role {
  USER
  ADMIN
  RECRUITER
  // Client who asks PartFind to source gigs/candidates for them (managed service),
  // as opposed to RECRUITER who self-serves by posting jobs directly.
  SERVICE_SEEKER
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NOT_PRESENT
}

enum PostApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Time basis for a post's rate/engagement.
enum PayPeriod {
  HOURLY
  DAILY
  MONTHLY
}

model Rating {
  id          String   @id @default(uuid())
  postId      String
  recruiterId String // The recruiter giving the rating
  userId      String // The user being rated
  rating      Int // 1-5 stars
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  recruiter User @relation("RecruiterRatings", fields: [recruiterId], references: [id], onDelete: Cascade)
  user      User @relation("UserRatings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], map: "rating_post_user_unique") // One rating per user per job
}

model RecruiterRating {
  id          String   @id @default(uuid())
  postId      String
  userId      String   // The user giving the rating
  recruiterId String   // The recruiter being rated
  rating      Int      // 1-5 stars
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation("UserRecruiterRatings", fields: [userId], references: [id], onDelete: Cascade)
  recruiter User @relation("RecruiterReceivedRatings", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], map: "recruiter_rating_post_user_unique") // One rating per user per job
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  deviceInfo String?
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model FlaggedUser {
  id        String   @id @default(uuid())
  userId    String
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

// A user-submitted report against a post (e.g. spam, scam, inappropriate).
model PostReport {
  id         String       @id @default(uuid())
  postId     String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User         @relation("UserPostReports", fields: [reporterId], references: [id], onDelete: Cascade)

  // One report per user per post
  @@unique([postId, reporterId])
}

model Certificate {
  id          String   @id @default(uuid())
  userId      String
  postId      String
  recruiterId String
  rating      Int?     // null = participation/attendance certificate (not yet rated)
  issuedAt    DateTime @default(now())

  user      User @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  recruiter User @relation("RecruiterCertificates", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], map: "certificate_post_user_unique")
}

model AppVersion {
  id           String   @id @default(uuid())
  version      String
  buildNumber  Int      @default(1)
  platform     String   @default("android")
  forceUpdate  Boolean  @default(false)
  message      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  content   String
  image     String?
  author    String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  is_active Boolean  @default(true)
}

model Client {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  avatar    String?
  rating    Int      @default(5)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Referral codes. Each code belongs to an owner (identified by name + email) and
// tracks how many accounts signed up using it. A code can be applied once per
// new account, at first-time signup only.
model ReferralCode {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String // owner's name
  email       String // owner's email
  usage_count Int      @default(0)
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

